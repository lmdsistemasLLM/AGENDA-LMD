{
  "name": "frontend",
  "private": true,
  "version": "1.1.1",
  "description": "Agenda LMD Preview com diagnostico Firebird e instalador Windows.",
  "author": "LMD Sistemas",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "sync:branding": "node ./scripts/sync-branding.cjs",
    "dev": "npm run sync:branding && vite --port 5173",
    "build": "npm run sync:branding && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron": "cross-env NODE_ENV=development electron .",
    "dev:desktop": "concurrently \"npm run dev\" \"wait-on tcp:5173 && npm run electron\"",
    "build:desktop": "npm run build && electron-builder",
    "build:desktop:dir": "npm run build && electron-builder --win dir"
  },
  "build": {
    "appId": "com.agendalmd.preview",
    "productName": "Agenda LMD Preview",
    "afterSign": "scripts/after-sign-branding.cjs",
    "directories": {
      "output": "dist-electron",
      "buildResources": "../assets"
    },
    "win": {
      "target": "zip",
      "icon": "../assets/icon.ico"
    },
    "extraResources": [
      {
        "from": "../assets",
        "to": "branding",
        "filter": [
          "icon.ico",
          "logo.png"
        ]
      },
      {
        "from": "../api-python/dist/agenda-api-x86",
        "to": "api/x86",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../api-python/dist/agenda-api-x64",
        "to": "api/x64",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "dist-app",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "axios": "^1.16.1",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  }
}
